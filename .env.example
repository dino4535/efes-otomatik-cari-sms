# Uygulama
PORT=5555
HOST=0.0.0.0
# Docker/üretimde production kullanın.
NODE_ENV=development
APP_COMPANY_NAME=Efes
APP_BRANCH=3
APP_TIMEZONE=Europe/Istanbul

# ERP SQL Server (salt okunur hesap kullanın)
# İlk çalıştırmada bu değerler ayar veritabanına yazılır; sonrasında
# Ayarlar > ERP Veritabanı ekranından değiştirilebilir.
ERP_SERVER=127.0.0.1
ERP_PORT=1433
ERP_DATABASE=DINO2026
ERP_USER=erp_kullanici
ERP_PASSWORD=erp_sifresi
ERP_ENCRYPT=false
ERP_TRUST_CERT=true

# Yerel uygulama veritabanı
APP_DB_PATH=./data/app.db

# Oturum — üretimde en az 32 karakterlik rastgele bir değer girin.
SESSION_SECRET=degistirin-bu-degeri
SESSION_HOURS=8

# İlk admin (yalnızca ilk çalıştırmada oluşturulur)
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=guclu-bir-sifre-belirleyin
ADMIN_FULL_NAME=Sistem Yöneticisi

# Yedekleme (isteğe bağlı)
# BACKUP_DIR=./data/backups
# BACKUP_KEEP=30
