<%
  const canManage = can('users.manage');
  const defaultUserPermissions = roleDefaults.user || [];
%>
<div class="page-head"
     data-current-role="<%= currentUser.role %>"
     data-current-user-id="<%= currentUser.id %>"
     data-default-erp-database="<%= defaultErpDatabase || '' %>"
     data-default-branch="<%= defaultBranch %>">
  <div>
    <h2>Kullanıcılar</h2>
    <p class="muted">Kullanıcı hesapları, roller ve yetkiler</p>
  </div>
  <% if (canManage) { %>
    <div class="page-actions">
      <button type="button" class="btn btn-primary" id="newUserBtn">+ Yeni Kullanıcı</button>
    </div>
  <% } %>
</div>

<div class="card">
  <div class="table-toolbar">
    <div class="filters">
      <label class="field field-inline">
        <span>Ara</span>
        <input type="search" id="userSearch" placeholder="Kullanıcı adı veya ad soyad">
      </label>
    </div>
    <span class="muted" id="userCount"></span>
  </div>
  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th>Kullanıcı</th>
          <th>Rol</th>
          <th>Veritabanı / Şube</th>
          <th>Durum</th>
          <th>Son Giriş</th>
          <th>Oluşturulma</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="usersBody">
        <tr><td colspan="7" class="empty-state">Kullanıcılar yükleniyor…</td></tr>
      </tbody>
    </table>
  </div>
</div>

<div class="modal" id="userModal" aria-hidden="true">
  <div class="modal-backdrop" data-close-modal></div>
  <div class="modal-dialog modal-lg" role="dialog" aria-modal="true" aria-labelledby="userModalTitle">
    <div class="modal-head">
      <div>
        <h3 id="userModalTitle">Yeni Kullanıcı</h3>
        <p class="muted">Kullanıcı bilgilerini ve yetkilerini belirleyin.</p>
      </div>
      <button type="button" class="icon-btn" data-close-modal aria-label="Kapat">×</button>
    </div>
    <div class="modal-body">
      <form id="userForm" class="form">
        <input type="hidden" id="userId">
        <div class="form-grid">
          <label class="field">
            <span>Kullanıcı Adı</span>
            <input type="text" id="userUsername" required minlength="3" maxlength="32" pattern="[a-zA-Z0-9._\-]+">
            <small class="hint">Harf, rakam, nokta, tire ve alt çizgi.</small>
          </label>
          <label class="field">
            <span>Ad Soyad</span>
            <input type="text" id="userFullName" maxlength="100">
          </label>
          <label class="field">
            <span>Rol</span>
            <select id="userRole">
              <option value="user">Kullanıcı</option>
              <% if (currentUser.role === 'admin') { %><option value="admin">Yönetici</option><% } %>
            </select>
          </label>
          <% if (currentUser.role === 'admin') { %>
            <label class="field">
              <span>ERP Veritabanı</span>
              <input type="text" id="userErpDatabase" required maxlength="128" placeholder="Örn. BERMER2026">
              <small class="hint">Kullanıcının yaşlandırma sorgularında kullanılacak SQL Server veritabanı.</small>
            </label>
            <label class="field">
              <span>Şube Kodu</span>
              <input type="number" id="userBranch" required min="0" max="999" placeholder="Örn. 0">
              <small class="hint">Kullanıcının göreceği ERP şubesi (SUBE_KODU).</small>
            </label>
          <% } %>
          <label class="field" id="passwordField">
            <span>Şifre</span>
            <input type="password" id="userPassword" minlength="8" autocomplete="new-password">
            <small class="hint">En az 8 karakter, bir harf ve bir rakam. Kullanıcı ilk girişte değiştirmek zorunda kalır.</small>
          </label>
        </div>
        <% if (currentUser.role !== 'admin') { %>
          <div class="alert alert-info compact-alert">
            ERP veritabanı ve şube yalnızca sistem yöneticisi tarafından değiştirilebilir. Yeni kullanıcılar sizin veritabanı ve şubenizi devralır.
          </div>
        <% } %>

        <div id="permissionsSection">
          <h4 class="form-section-title">Yetkiler</h4>
          <p class="hint">Yönetici rolü tüm yetkilere otomatik olarak sahiptir.</p>
          <%- include('partials/permissions', { catalog: permissionCatalog, selected: defaultUserPermissions }) %>
        </div>

        <div class="alert alert-danger hidden" id="userFormError"></div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary" id="userSaveBtn">Kaydet</button>
          <button type="button" class="btn btn-ghost" data-close-modal>Vazgeç</button>
        </div>
      </form>
    </div>
  </div>
</div>

<div class="modal" id="passwordModal" aria-hidden="true">
  <div class="modal-backdrop" data-close-modal></div>
  <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="passwordModalTitle">
    <div class="modal-head">
      <div>
        <h3 id="passwordModalTitle">Şifre Sıfırla</h3>
        <p class="muted" id="passwordModalMeta"></p>
      </div>
      <button type="button" class="icon-btn" data-close-modal aria-label="Kapat">×</button>
    </div>
    <div class="modal-body">
      <form id="passwordForm" class="form">
        <input type="hidden" id="passwordUserId">
        <label class="field">
          <span>Yeni Şifre</span>
          <input type="password" id="passwordValue" required minlength="8" autocomplete="new-password">
          <small class="hint">Kullanıcı bir sonraki girişinde şifresini değiştirmek zorunda kalır.</small>
        </label>
        <div class="alert alert-danger hidden" id="passwordFormError"></div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Şifreyi Sıfırla</button>
          <button type="button" class="btn btn-ghost" data-close-modal>Vazgeç</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="/public/js/users.js" defer></script>
